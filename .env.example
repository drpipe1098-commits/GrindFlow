# =============================================================================
# GrindFlow — plantilla de variables de entorno durante la migracion
# Next.js usa .env.local. Laravel usa .env. NUNCA commitees valores reales.
# =============================================================================

# --- Laravel 13 -------------------------------------------------------------
APP_NAME="GrindFlow"
APP_ENV="local"
APP_KEY=""
APP_DEBUG="true"
APP_URL="http://localhost:8000"
APP_TIMEZONE="UTC"
APP_LOCALE="es"
APP_FALLBACK_LOCALE="en"
APP_FAKER_LOCALE="es_ES"
APP_MAINTENANCE_DRIVER="file"

DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="grindflow"
DB_USERNAME="grindflow"
DB_PASSWORD=""
DB_SOCKET=""
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"
DB_URL=""

CACHE_STORE="array"
SESSION_DRIVER="file"
SESSION_LIFETIME="120"
QUEUE_CONNECTION="sync"
FILESYSTEM_DISK="local"
LOG_CHANNEL="stack"
LOG_LEVEL="debug"

# Media Vault. Use "s3" when object storage is configured in production.
MEDIA_DISK="local"

# Direct-to-storage uploads. The application never exposes these secrets.
MEDIA_DIRECT_UPLOAD_DISK="media"
MEDIA_DIRECT_UPLOAD_MAX_BYTES="2147483648"
MEDIA_DIRECT_UPLOAD_TTL_MINUTES="15"

# Dedicated media object storage. Empty values fall back to AWS_* and then
# legacy R2_* credentials while the migration is in progress.
MEDIA_STORAGE_ACCESS_KEY_ID=""
MEDIA_STORAGE_SECRET_ACCESS_KEY=""
MEDIA_STORAGE_REGION=""
MEDIA_STORAGE_BUCKET=""
MEDIA_STORAGE_URL=""
MEDIA_STORAGE_ENDPOINT=""
MEDIA_STORAGE_USE_PATH_STYLE_ENDPOINT="false"

# Generic S3-compatible storage for the Laravel application.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="auto"
AWS_BUCKET=""
AWS_URL=""
AWS_ENDPOINT=""
AWS_USE_PATH_STYLE_ENDPOINT="false"

# --- Legacy Next.js / Supabase (temporary during migration) -----------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="pega-aqui-la-anon-key"
SUPABASE_SERVICE_ROLE_KEY="pega-aqui-la-service-role-key"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Cloudflare R2 legacy variables ----------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET="grindflow-dev"
R2_ENDPOINT="http://127.0.0.1:9000"
R2_REGION="auto"
R2_PUBLIC_BASE_URL="http://127.0.0.1:9000/grindflow-dev"

# --- Upload limits ----------------------------------------------------------
UPLOAD_PRESIGN_TTL_SECONDS="300"
UPLOAD_MAX_BYTES_PER_FILE="2147483648"
UPLOAD_MAX_FILES_PER_LINK="50"

# --- Legacy application URLs -----------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHORT_LINK_BASE_URL="http://localhost:3000/l"
UPLOAD_LINK_SECRET="cambia-esto-por-32-bytes-aleatorios"

# --- Credential encryption -------------------------------------------------
ENCRYPTION_MASTER_KEY=""

# --- Traffic engine ---------------------------------------------------------
CLICK_IP_SALT=""
CLICK_RATE_LIMIT_PER_MINUTE="30"

# --- Cloud ingestion connectors --------------------------------------------
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OAUTH_STATE_SECRET=""

# --- Schedulers / workers ---------------------------------------------------
SCHEDULER_TICK_SECONDS="300"
INGEST_WORKER_BATCH_SIZE="2"
INGEST_WORKER_POLL_SECONDS="10"
INGEST_MAX_BYTES_PER_FILE="5368709120"
PUBLISH_WORKER_BATCH_SIZE="3"
PUBLISH_WORKER_POLL_SECONDS="15"
PUBLISH_DISPATCH_SECONDS="60"

# --- Scheduling defaults ----------------------------------------------------
DEFAULT_ASSET_COOLDOWN_DAYS="30"
DEFAULT_OUTFIT_COOLDOWN_DAYS="7"
