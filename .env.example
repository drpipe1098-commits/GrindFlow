# =============================================================================
# GrindFlow & Traffic Engine — plantilla de variables de entorno
# Copia este archivo a .env.local y rellena los valores. NUNCA commitees .env.local.
# =============================================================================

# --- Supabase --------------------------------------------------------------
# En desarrollo local con `supabase start`, la CLI imprime estos tres valores.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="pega-aqui-la-anon-key"
# Clave de servicio: omite el RLS por completo. Solo en el servidor y en los
# workers. Si se filtra al navegador, todo el aislamiento multi-tenant cae.
SUPABASE_SERVICE_ROLE_KEY="pega-aqui-la-service-role-key"

# Cadena de conexion directa a Postgres. La usan las migraciones y los workers.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Cloudflare R2 (API compatible con S3) ---------------------------------
# En desarrollo se puede apuntar a MinIO: docker compose up minio
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET="grindflow-dev"
# Con R2 real: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT="http://127.0.0.1:9000"
R2_REGION="auto"
# Dominio publico del bucket para los archivos de teaser ya sanitizados.
R2_PUBLIC_BASE_URL="http://127.0.0.1:9000/grindflow-dev"

# --- Limites de subida -----------------------------------------------------
# Vigencia de cada URL prefirmada, en segundos. Corta a proposito: la URL es
# una credencial de escritura y no debe sobrevivir a la sesion de subida.
UPLOAD_PRESIGN_TTL_SECONDS="300"
# Peso maximo por archivo, en bytes (por defecto 2 GiB).
UPLOAD_MAX_BYTES_PER_FILE="2147483648"
# Cantidad maxima de archivos por enlace de subida.
UPLOAD_MAX_FILES_PER_LINK="50"

# --- Aplicacion ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base de los enlaces cortos. Por defecto la misma app, en /l/[slug].
NEXT_PUBLIC_SHORT_LINK_BASE_URL="http://localhost:3000/l"

# Secreto para firmar los tokens de los enlaces de subida.
# Genera uno con: openssl rand -hex 32
UPLOAD_LINK_SECRET="cambia-esto-por-32-bytes-aleatorios"

# --- Cifrado de credenciales -----------------------------------------------
# Clave maestra AES-256-GCM: 32 bytes en hexadecimal, exactamente 64 caracteres.
#   openssl rand -hex 32
# Cifra los tokens OAuth y las API keys de las plataformas. Si se pierde, las
# credenciales guardadas son irrecuperables y hay que reconectar cada cuenta.
# Si se filtra, un volcado de la base basta para leerlas todas: tratala como la
# credencial mas sensible del despliegue.
ENCRYPTION_MASTER_KEY=""

# --- Acortador y limite de tasa --------------------------------------------
# Sal del hash de IP. Del acortador nunca se guarda una IP en claro, solo su
# hash con esta sal; cambiarla reinicia las ventanas de limite en curso.
#   openssl rand -hex 16
CLICK_IP_SALT=""
# Clics aceptados por IP y minuto antes de empezar a descartar.
CLICK_RATE_LIMIT_PER_MINUTE="30"
# La ventana de deduplicacion por IP (60 s) es una constante de la funcion
# record_link_click, en la migracion 001000: no es configurable desde el entorno
# porque quien la invoca es anonimo y podria elegir un valor que la anule.

# --- Conectores de ingesta desde la nube -----------------------------------
# Solo hacen falta si se va a usar la ingesta desde Dropbox. Sin ellas el panel
# arranca igual; el error aparece al intentar conectar una nube.
# Se sacan de https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
# Google Drive es opcional: se puede empezar solo con Dropbox mientras corre
# el tramite de verificacion del alcance drive.readonly, que tarda semanas.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Firma el parametro `state` de OAuth2, que es lo que impide que un tercero
# consiga conectar SU nube dentro de la organizacion de otro.
#   openssl rand -hex 32
OAUTH_STATE_SECRET=""
# URI de retorno registrada en Dropbox. Tiene que coincidir caracter a caracter
# con la de la consola del proveedor:
#   <NEXT_PUBLIC_APP_URL>/api/conectores/dropbox/callback
#   <NEXT_PUBLIC_APP_URL>/api/conectores/google/callback

# --- Programador de escaneos -----------------------------------------------
# Cada cuanto revisa el worker si toca escanear alguna conexion. La cadencia
# de cada conexion la fija su propia columna scan_interval_minutes.
SCHEDULER_TICK_SECONDS="300"

# --- Worker de ingesta -----------------------------------------------------
INGEST_WORKER_BATCH_SIZE="2"
INGEST_WORKER_POLL_SECONDS="10"
# Peso maximo de un archivo traido de la nube (por defecto 5 GiB).
INGEST_MAX_BYTES_PER_FILE="5368709120"

# --- Worker de publicacion -------------------------------------------------
PUBLISH_WORKER_BATCH_SIZE="3"
PUBLISH_WORKER_POLL_SECONDS="15"
# Cada cuanto busca el despachador programaciones vencidas.
PUBLISH_DISPATCH_SECONDS="60"

# --- Motor de programacion (Hard Rule) -------------------------------------
# Valores por defecto de una organizacion nueva; cada una puede ajustarlos.
DEFAULT_ASSET_COOLDOWN_DAYS="30"
DEFAULT_OUTFIT_COOLDOWN_DAYS="7"
