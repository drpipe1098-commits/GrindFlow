{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "server-only": ["./src/workers/support/server-only-shim.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
